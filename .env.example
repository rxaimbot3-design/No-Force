# Tong Ghor configuration
# Copy to .env and fill in values before running.

# Discord
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_application_id
DISCORD_PUBLIC_KEY=your_discord_interactions_public_key

# Root / bootstrap identity (zero-trust, immutable via platform commands)
TONG_GHOR_ROOT_USER_ID=your_discord_user_id

# Database (PostgreSQL)
DATABASE_URL=postgresql://tongghor:password@localhost:5432/tongghor
DATABASE_READ_URL=postgresql://tongghor:password@localhost:5432/tongghor

# Cache / rate limit / bus (Redis)
REDIS_URL=redis://localhost:6379

# Server
PORT=8080
NODE_ENV=production

# Sharding
SHARD_COUNT=auto

# Logging
LOG_LEVEL=info
